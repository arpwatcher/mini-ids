# sample ruleset for testing
alert tcp any any -> 10.0.0.10 22 (msg:"ssh connection attempt"; sid:1000001;)
alert udp any any -> any 53 (msg:"dns query"; sid:1000002;)

# blank lines and comments should be skipped
alert tcp any any -> any 23 (msg:"telnet cleartext"; sid:1000003;)

# stateful rule: fires once per source that crosses the threshold, not per packet
alert tcp any any -> any 22 (msg:"ssh brute force"; sid:1000004; count:5; seconds:60;)

# content matching: catches cleartext ftp passwords going over the wire
alert tcp any any -> any 21 (msg:"ftp cleartext password"; sid:1000005; content:"PASS ";)

# bidirectional: catches smb traffic no matter which side initiated
alert tcp any any <> any 445 (msg:"smb traffic"; sid:1000006;)
